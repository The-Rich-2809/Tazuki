@* Views/Shared/_LayoutAdmin.cshtml *@
<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="~/img/tazukilogo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">

    <!-- No-flash theme init -->
    <script>
        (function () {
            var t = localStorage.getItem('tz-theme') || 'light';
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>

    <style>
        /* ── Design System ── */
        :root {
            --bg:           #f0f2f7;
            --bg-card:      #ffffff;
            --bg-nav:       rgba(255,255,255,0.95);
            --bg-input:     #ffffff;
            --bg-hover:     #eef4fc;
            --text:         #1a2035;
            --text-2:       #4a5568;
            --text-muted:   #8896aa;
            --border:       #e4e9f2;
            --brand:        #4B92DB;
            --brand-dark:   #3a7cc0;
            --brand-light:  rgba(75,146,219,0.12);
            --brand-rgb:    75,146,219;
            --danger:       #ef4444;
            --success:      #22c55e;
            --warning:      #f59e0b;
            --sh-sm:        0 1px 4px rgba(0,0,0,.05), 0 4px 16px rgba(0,0,0,.06);
            --sh-md:        0 4px 12px rgba(0,0,0,.06), 0 10px 30px rgba(0,0,0,.08);
            --sh-lg:        0 8px 24px rgba(0,0,0,.08), 0 20px 50px rgba(0,0,0,.12);
            --r-sm:         .5rem;
            --r:            .75rem;
            --r-lg:         1.25rem;
            --nav-h:        64px;
            --ease:         .22s cubic-bezier(.4,0,.2,1);
        }

        html[data-theme="dark"] {
            --bg:           #0d1117;
            --bg-card:      #161c2d;
            --bg-nav:       rgba(22,28,45,0.97);
            --bg-input:     #1e2640;
            --bg-hover:     #1e2640;
            --text:         #e8edf5;
            --text-2:       #a0aec0;
            --text-muted:   #6b7a99;
            --border:       #253052;
            --brand:        #5ba3e8;
            --brand-dark:   #4B92DB;
            --brand-light:  rgba(91,163,232,0.14);
            --brand-rgb:    91,163,232;
            --sh-sm:        0 1px 4px rgba(0,0,0,.3), 0 4px 16px rgba(0,0,0,.35);
            --sh-md:        0 4px 12px rgba(0,0,0,.4), 0 10px 30px rgba(0,0,0,.45);
            --sh-lg:        0 8px 24px rgba(0,0,0,.5), 0 20px 50px rgba(0,0,0,.55);
        }

        *, *::before, *::after { box-sizing: border-box; }
        html { scroll-behavior: smooth; }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: var(--bg);
            color: var(--text);
            padding-top: var(--nav-h);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        body, .card, .adm-navbar, .form-control, .form-select,
        .input-group-text, .list-group-item, .modal-content, .dropdown-menu {
            transition: background-color var(--ease), border-color var(--ease), color var(--ease);
        }

        h1,h2,h3,h4,h5,h6 { color: var(--text); font-weight: 700; }
        p { color: var(--text-2); }

        /* ── Admin Navbar ── */
        .adm-navbar {
            position: fixed;
            inset: 0 0 auto 0;
            z-index: 1100;
            height: var(--nav-h);
            background: var(--bg-nav);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--border);
        }

        .adm-inner {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }

        .adm-brand {
            display: flex;
            align-items: center;
            gap: .6rem;
            text-decoration: none;
            font-weight: 700;
            font-size: 1rem;
            color: var(--brand);
            flex-shrink: 0;
        }

        .adm-brand:hover { color: var(--brand-dark); }

        .adm-badge {
            background: var(--brand);
            color: #fff;
            font-size: .6rem;
            font-weight: 700;
            padding: .15rem .45rem;
            border-radius: .3rem;
            letter-spacing: .05em;
            text-transform: uppercase;
        }

        .adm-links {
            display: flex;
            align-items: center;
            gap: .1rem;
            list-style: none;
            margin: 0; padding: 0;
            flex: 1;
            margin-left: 1.5rem;
            overflow-x: auto;
        }

        .adm-links a {
            display: flex; align-items: center; gap: .4rem;
            padding: .45rem .8rem;
            border-radius: var(--r-sm);
            color: var(--text-2);
            font-size: .84rem;
            font-weight: 500;
            text-decoration: none;
            white-space: nowrap;
            transition: color var(--ease), background var(--ease);
        }

        .adm-links a:hover, .adm-links a.active {
            color: var(--brand);
            background: var(--brand-light);
        }

        @@media (max-width: 991.98px) { .adm-links { display: none; } }

        .adm-right { display: flex; align-items: center; gap: .5rem; flex-shrink: 0; }

        .adm-ibtn {
            width: 36px; height: 36px;
            border-radius: 50%;
            background: transparent;
            border: 1px solid var(--border);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: var(--text-2);
            font-size: .95rem;
            cursor: pointer;
            text-decoration: none;
            transition: background var(--ease), color var(--ease), border-color var(--ease);
        }

        .adm-ibtn:hover {
            background: var(--brand-light);
            color: var(--brand);
            border-color: var(--brand);
        }

        .ic-sun  { display: none; }
        .ic-moon { display: inline-block; }
        html[data-theme="dark"] .ic-sun  { display: inline-block; }
        html[data-theme="dark"] .ic-moon { display: none; }

        .adm-ham {
            display: none;
            flex-direction: column;
            justify-content: center;
            gap: 5px;
            background: none;
            border: 1px solid var(--border);
            border-radius: var(--r-sm);
            width: 36px; height: 36px;
            cursor: pointer;
            padding: 0 7px;
        }

        .adm-ham span {
            display: block;
            height: 2px;
            background: var(--text-2);
            border-radius: 2px;
            transition: all .3s;
        }

        @@media (max-width: 991.98px) { .adm-ham { display: flex; } }

        .adm-drawer {
            display: none;
            position: fixed;
            top: var(--nav-h);
            left: 0; right: 0;
            background: var(--bg-card);
            border-bottom: 1px solid var(--border);
            box-shadow: var(--sh-lg);
            z-index: 1090;
            padding: .75rem;
            flex-direction: column;
            gap: .15rem;
            max-height: calc(100vh - var(--nav-h));
            overflow-y: auto;
        }

        .adm-drawer.open { display: flex; }

        .adm-drawer a {
            display: flex; align-items: center; gap: .75rem;
            padding: .65rem 1rem;
            border-radius: var(--r-sm);
            color: var(--text);
            font-size: .9rem;
            font-weight: 500;
            text-decoration: none;
            transition: background var(--ease), color var(--ease);
        }

        .adm-drawer a.active { color: var(--brand); background: var(--brand-light); }
        .adm-drawer a:hover  { background: var(--brand-light); color: var(--brand); }
        .adm-drawer hr { border-color: var(--border); margin: .4rem 0; }

        /* ── Cards ── */
        .card {
            background: var(--bg-card) !important;
            border: 1px solid var(--border) !important;
            box-shadow: var(--sh-sm) !important;
            border-radius: var(--r) !important;
        }

        .card-header, .card-footer {
            background: var(--bg-card) !important;
            border-color: var(--border) !important;
        }

        /* ── Forms ── */
        .form-control, .form-select {
            background-color: var(--bg-input) !important;
            border-color: var(--border)       !important;
            color: var(--text)                !important;
            border-radius: var(--r-sm)        !important;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--brand)    !important;
            box-shadow: 0 0 0 3px rgba(var(--brand-rgb),.2) !important;
            background-color: var(--bg-input) !important;
            color: var(--text) !important;
        }

        .form-control::placeholder { color: var(--text-muted); }

        .form-label { color: var(--text); font-weight: 600; }

        .input-group-text {
            background: var(--bg-input) !important;
            border-color: var(--border) !important;
            color: var(--text-muted)    !important;
        }

        /* ── Buttons ── */
        .btn-primary {
            background-color: var(--brand) !important;
            border-color: var(--brand)     !important;
            color: #fff !important;
            font-weight: 600;
            border-radius: var(--r-sm) !important;
        }

        .btn-primary:hover, .btn-primary:focus {
            background-color: var(--brand-dark) !important;
            border-color: var(--brand-dark)     !important;
            box-shadow: 0 4px 16px rgba(var(--brand-rgb),.35) !important;
        }

        .btn-outline-primary {
            color: var(--brand) !important;
            border-color: var(--brand) !important;
        }

        .btn-outline-primary:hover {
            background: var(--brand) !important;
            color: #fff !important;
        }

        .btn-outline-danger {
            color: var(--danger) !important;
            border-color: var(--danger) !important;
        }

        .btn-outline-danger:hover {
            background: var(--danger) !important;
            color: #fff !important;
        }

        /* ── Tables ── */
        .table {
            color: var(--text) !important;
            border-color: var(--border) !important;
        }

        .table > :not(caption) > * > * {
            background-color: transparent !important;
            border-color: var(--border) !important;
            color: var(--text) !important;
        }

        .table-light, .table-light th, .table-light td {
            background: var(--brand-light) !important;
            color: var(--text) !important;
        }

        /* ── List group ── */
        .list-group-item {
            background: var(--bg-card) !important;
            border-color: var(--border) !important;
            color: var(--text) !important;
        }

        /* ── Modals ── */
        .modal-content {
            background: var(--bg-card) !important;
            border-color: var(--border) !important;
            color: var(--text) !important;
            border-radius: var(--r-lg) !important;
        }

        .modal-header, .modal-footer { border-color: var(--border) !important; }

        .btn-close { filter: invert(0); }
        html[data-theme="dark"] .btn-close { filter: invert(1); }

        /* ── Alerts ── */
        .alert-danger {
            background: rgba(239,68,68,.1) !important;
            border-color: rgba(239,68,68,.3) !important;
            color: #ef4444 !important;
        }

        .alert-success {
            background: rgba(var(--brand-rgb),.1) !important;
            border-color: rgba(var(--brand-rgb),.3) !important;
            color: var(--brand) !important;
        }

        .alert-warning {
            background: rgba(245,158,11,.1) !important;
            border-color: rgba(245,158,11,.3) !important;
            color: #b45309 !important;
        }

        /* ── Dropdown ── */
        .dropdown-menu {
            background: var(--bg-card) !important;
            border-color: var(--border) !important;
            box-shadow: var(--sh-lg) !important;
            border-radius: var(--r) !important;
        }

        .dropdown-item { color: var(--text) !important; border-radius: var(--r-sm); }
        .dropdown-item:hover { background: var(--brand-light) !important; color: var(--brand) !important; }
        .dropdown-divider { border-color: var(--border) !important; }

        /* ── Badge ── */
        .badge-brand {
            background: var(--brand-light) !important;
            color: var(--brand) !important;
            border: 1px solid rgba(var(--brand-rgb),.25) !important;
        }

        /* ── Page header ── */
        .adm-page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: .75rem;
            margin-bottom: 1.75rem;
            padding-bottom: 1.25rem;
            border-bottom: 1px solid var(--border);
        }

        .adm-page-header h1 {
            font-size: 1.6rem;
            margin: 0;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    @{
        string ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        string act  = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    }

    <!-- Admin Navbar -->
    <header class="adm-navbar">
        <div class="container-fluid adm-inner px-3 px-lg-4">

            <a class="adm-brand" asp-controller="Admin" asp-action="Index">
                <i class="bi bi-shield-check fs-5"></i>
                Tazuki
                <span class="adm-badge">Admin</span>
            </a>

            <ul class="adm-links">
                <li>
                    <a class="@(act=="Index" ? "active" : "")" asp-controller="Admin" asp-action="Index">
                        <i class="bi bi-play-circle"></i>Galería
                    </a>
                </li>
                <li>
                    <a class="@(act=="ListaDisenos" ? "active" : "")" asp-controller="Admin" asp-action="ListaDisenos">
                        <i class="bi bi-table"></i>Diseños
                    </a>
                </li>
                <li>
                    <a class="@(act=="AgregarDiseno" ? "active" : "")" asp-controller="Admin" asp-action="AgregarDiseno">
                        <i class="bi bi-plus-circle"></i>Agregar
                    </a>
                </li>
                <li>
                    <a class="@(act=="AgregarDisenoArchivo" ? "active" : "")" asp-controller="Admin" asp-action="AgregarDisenoArchivo">
                        <i class="bi bi-upload"></i>Subir Archivo
                    </a>
                </li>
                <li>
                    <a class="@(act=="Etiquetas" ? "active" : "")" asp-controller="Admin" asp-action="Etiquetas">
                        <i class="bi bi-tags"></i>Etiquetas
                    </a>
                </li>
                <li>
                    <a class="@(act=="TamanosTaza" ? "active" : "")" asp-controller="Admin" asp-action="TamanosTaza">
                        <i class="bi bi-rulers"></i>Tamaños
                    </a>
                </li>
                <li>
                    <a class="@(act=="Usuarios" ? "active" : "")" asp-controller="Admin" asp-action="Usuarios">
                        <i class="bi bi-people"></i>Usuarios
                    </a>
                </li>
            </ul>

            <div class="adm-right">
                <button class="adm-ibtn" id="themeToggle" aria-label="Cambiar tema">
                    <i class="bi bi-sun-fill ic-sun"></i>
                    <i class="bi bi-moon-fill ic-moon"></i>
                </button>

                <a class="adm-ibtn" asp-controller="Home" asp-action="Index" title="Ver sitio">
                    <i class="bi bi-house"></i>
                </a>

                <button class="adm-ham" id="hamBtn" aria-label="Menú">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
    </header>

    <!-- Mobile drawer -->
    <nav class="adm-drawer" id="mobileDrawer">
        <a class="@(act=="Index" ? "active" : "")" asp-controller="Admin" asp-action="Index">
            <i class="bi bi-play-circle"></i>Galería
        </a>
        <a class="@(act=="ListaDisenos" ? "active" : "")" asp-controller="Admin" asp-action="ListaDisenos">
            <i class="bi bi-table"></i>Diseños (tabla)
        </a>
        <a class="@(act=="AgregarDiseno" ? "active" : "")" asp-controller="Admin" asp-action="AgregarDiseno">
            <i class="bi bi-plus-circle"></i>Agregar Diseño
        </a>
        <a class="@(act=="AgregarDisenoArchivo" ? "active" : "")" asp-controller="Admin" asp-action="AgregarDisenoArchivo">
            <i class="bi bi-upload"></i>Subir Archivo
        </a>
        <a class="@(act=="Etiquetas" ? "active" : "")" asp-controller="Admin" asp-action="Etiquetas">
            <i class="bi bi-tags"></i>Etiquetas
        </a>
        <a class="@(act=="TamanosTaza" ? "active" : "")" asp-controller="Admin" asp-action="TamanosTaza">
            <i class="bi bi-rulers"></i>Tamaños de Taza
        </a>
        <a class="@(act=="Usuarios" ? "active" : "")" asp-controller="Admin" asp-action="Usuarios">
            <i class="bi bi-people"></i>Usuarios
        </a>
        <hr />
        <a asp-controller="Home" asp-action="Index">
            <i class="bi bi-house"></i>Volver al Sitio
        </a>
    </nav>

    <!-- Main content -->
    <main class="py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const themeBtn = document.getElementById('themeToggle');
        function setTheme(t) {
            document.documentElement.setAttribute('data-theme', t);
            localStorage.setItem('tz-theme', t);
        }
        themeBtn?.addEventListener('click', () => {
            setTheme(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
        });

        const hamBtn = document.getElementById('hamBtn');
        const drawer = document.getElementById('mobileDrawer');
        hamBtn?.addEventListener('click', (e) => {
            e.stopPropagation();
            drawer.classList.toggle('open');
        });
        document.addEventListener('click', (e) => {
            if (!drawer?.contains(e.target) && !hamBtn?.contains(e.target))
                drawer?.classList.remove('open');
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
