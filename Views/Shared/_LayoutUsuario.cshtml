<!doctype html>
<html lang="es" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Tazas y regalos sublimados personalizados. Fabricación rápida, envíos a todo México." />
    <link rel="icon" href="~/img/tazukilogo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;1,14..32,400&display=swap" rel="stylesheet">
    @RenderSection("Head", required: false)

    <!-- No-flash theme init (runs before first paint) -->
    <script>
        (function () {
            var t = localStorage.getItem('tz-theme') ||
                (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>

    <style>
        /* ============================================================
           DESIGN SYSTEM — CSS VARIABLES
           ============================================================ */
        :root {
            --bg:           #f4f6fb;
            --bg-card:      #ffffff;
            --bg-nav:       rgba(255,255,255,0.94);
            --bg-input:     #ffffff;
            --bg-hover:     #f0f9f8;
            --text:         #1a2035;
            --text-2:       #4a5568;
            --text-muted:   #8896aa;
            --border:       #e4e9f2;
            --brand:        #3bbfad;
            --brand-dark:   #2ea796;
            --brand-light:  rgba(59,191,173,0.12);
            --brand-rgb:    59,191,173;
            --accent:       #f97316;
            --danger:       #ef4444;
            --success:      #22c55e;
            --sh-sm:        0 1px 4px rgba(0,0,0,.05), 0 4px 16px rgba(0,0,0,.06);
            --sh-md:        0 4px 12px rgba(0,0,0,.06), 0 10px 30px rgba(0,0,0,.08);
            --sh-lg:        0 8px 24px rgba(0,0,0,.08), 0 20px 50px rgba(0,0,0,.12);
            --r-sm:         .5rem;
            --r:            .75rem;
            --r-lg:         1.25rem;
            --nav-h:        64px;
            --bnav-h:       62px;
            --ease:         .22s cubic-bezier(.4,0,.2,1);
        }

        html[data-theme="dark"] {
            --bg:           #0d1117;
            --bg-card:      #161c2d;
            --bg-nav:       rgba(13,17,23,0.96);
            --bg-input:     #1e2640;
            --bg-hover:     #1e2640;
            --text:         #e8edf5;
            --text-2:       #a0aec0;
            --text-muted:   #6b7a99;
            --border:       #253052;
            --brand:        #4dd0c4;
            --brand-dark:   #3bbfad;
            --brand-light:  rgba(77,208,196,0.14);
            --brand-rgb:    77,208,196;
            --sh-sm:        0 1px 4px rgba(0,0,0,.3), 0 4px 16px rgba(0,0,0,.35);
            --sh-md:        0 4px 12px rgba(0,0,0,.4), 0 10px 30px rgba(0,0,0,.45);
            --sh-lg:        0 8px 24px rgba(0,0,0,.5), 0 20px 50px rgba(0,0,0,.55);
        }

        /* ============================================================
           BASE
           ============================================================ */
        *, *::before, *::after { box-sizing: border-box; }
        html { scroll-behavior: smooth; }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: var(--bg);
            color: var(--text);
            padding-top: var(--nav-h);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        /* Mobile: room for bottom nav */
        @@media (max-width: 991.98px) {
            body { padding-bottom: var(--bnav-h); }
        }

        /* Smooth global transitions on theme change */
        body, .card, .tz-navbar, .tz-footer, .tz-bottom-nav,
        .form-control, .form-select, .input-group-text,
        .accordion-button, .accordion-body, .list-group-item,
        .modal-content, .dropdown-menu, .tz-dropdown-menu {
            transition: background-color var(--ease), border-color var(--ease), color var(--ease);
        }

        /* ============================================================
           TYPOGRAPHY
           ============================================================ */
        h1,h2,h3,h4,h5,h6 { color: var(--text); font-weight: 700; }
        p { color: var(--text-2); }
        .text-secondary { color: var(--text-muted) !important; }
        .text-primary   { color: var(--brand)      !important; }
        a               { color: var(--brand); text-decoration: none; }
        a:hover         { color: var(--brand-dark); }

        /* ============================================================
           NAVBAR
           ============================================================ */
        .tz-navbar {
            position: fixed;
            inset: 0 0 auto 0;
            z-index: 1100;
            height: var(--nav-h);
            background: var(--bg-nav);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--border);
        }

        .tz-navbar .tz-inner {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }

        /* Brand */
        .tz-brand img {
            height: 44px;
            object-fit: contain;
            display: block;
        }

        /* Desktop links */
        .tz-links {
            display: flex;
            align-items: center;
            gap: .15rem;
            list-style: none;
            margin: 0; padding: 0;
        }

        .tz-links a {
            display: flex; align-items: center; gap: .4rem;
            padding: .45rem .85rem;
            border-radius: var(--r-sm);
            color: var(--text-2);
            font-size: .875rem;
            font-weight: 500;
            transition: color var(--ease), background var(--ease);
        }

        .tz-links a:hover, .tz-links a.active {
            color: var(--brand);
            background: var(--brand-light);
        }

        @@media (max-width: 991.98px) { .tz-links { display: none; } }

        /* Icon button (circle) */
        .tz-ibtn {
            width: 38px; height: 38px;
            border-radius: 50%;
            background: transparent;
            border: 1px solid var(--border);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: var(--text-2);
            font-size: 1rem;
            cursor: pointer;
            text-decoration: none;
            transition: background var(--ease), color var(--ease), border-color var(--ease);
            flex-shrink: 0;
        }

        .tz-ibtn:hover {
            background: var(--brand-light);
            color: var(--brand);
            border-color: var(--brand);
        }

        /* Right cluster */
        .tz-right { display: flex; align-items: center; gap: .5rem; }

        /* Theme icons */
        .ic-sun  { display: none; }
        .ic-moon { display: inline-block; }
        html[data-theme="dark"] .ic-sun  { display: inline-block; }
        html[data-theme="dark"] .ic-moon { display: none; }

        /* Account dropdown */
        .tz-drop { position: relative; }

        .tz-dmenu {
            display: none;
            position: absolute;
            top: calc(100% + .6rem);
            right: 0;
            min-width: 200px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--r);
            box-shadow: var(--sh-lg);
            padding: .5rem;
            z-index: 1200;
            animation: fadeDown .15s ease;
        }

        @@keyframes fadeDown {
            from { opacity:0; transform:translateY(-6px); }
            to   { opacity:1; transform:translateY(0); }
        }

        .tz-drop.open .tz-dmenu { display: block; }

        .tz-dmenu a {
            display: flex; align-items: center; gap: .6rem;
            padding: .55rem .75rem;
            border-radius: var(--r-sm);
            color: var(--text);
            font-size: .875rem;
            font-weight: 500;
            transition: background var(--ease), color var(--ease);
        }

        .tz-dmenu a:hover { background: var(--brand-light); color: var(--brand); }

        .tz-dmenu .dh {
            font-size: .72rem;
            color: var(--text-muted);
            padding: .35rem .75rem .45rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .06em;
        }

        .tz-dmenu hr { border-color: var(--border); margin: .35rem 0; }

        /* Hamburger */
        .tz-ham {
            display: none;
            flex-direction: column;
            justify-content: center;
            gap: 5px;
            background: none;
            border: 1px solid var(--border);
            border-radius: var(--r-sm);
            width: 38px; height: 38px;
            cursor: pointer;
            padding: 0 8px;
        }

        .tz-ham span {
            display: block;
            height: 2px;
            background: var(--text-2);
            border-radius: 2px;
            transition: all .3s;
        }

        @@media (max-width: 991.98px) { .tz-ham { display: flex; } }

        /* Mobile drawer */
        .tz-drawer {
            display: none;
            position: fixed;
            top: var(--nav-h);
            left: 0; right: 0;
            background: var(--bg-card);
            border-bottom: 1px solid var(--border);
            box-shadow: var(--sh-lg);
            z-index: 1090;
            padding: .75rem;
            flex-direction: column;
            gap: .15rem;
            max-height: calc(100vh - var(--nav-h));
            overflow-y: auto;
        }

        .tz-drawer.open { display: flex; }

        .tz-drawer a {
            display: flex; align-items: center; gap: .75rem;
            padding: .75rem 1rem;
            border-radius: var(--r-sm);
            color: var(--text);
            font-size: .95rem;
            font-weight: 500;
            transition: background var(--ease), color var(--ease);
        }

        .tz-drawer a:hover { background: var(--brand-light); color: var(--brand); }
        .tz-drawer .dd { border-color: var(--border); margin: .35rem 0; }

        /* ============================================================
           CARDS
           ============================================================ */
        .card {
            background: var(--bg-card) !important;
            border: 1px solid var(--border) !important;
            box-shadow: var(--sh-sm) !important;
            border-radius: var(--r) !important;
        }

        .card:hover {
            box-shadow: var(--sh-md) !important;
            transform: translateY(-2px);
            transition: box-shadow var(--ease), transform var(--ease);
        }

        .card-header, .card-footer {
            background: var(--bg-card) !important;
            border-color: var(--border) !important;
        }

        /* ============================================================
           BUTTONS
           ============================================================ */
        .btn-primary {
            background-color: var(--brand)  !important;
            border-color: var(--brand)      !important;
            color: #fff !important;
            font-weight: 600;
        }

        .btn-primary:hover, .btn-primary:focus {
            background-color: var(--brand-dark) !important;
            border-color: var(--brand-dark)     !important;
            box-shadow: 0 4px 16px rgba(var(--brand-rgb),.35) !important;
        }

        .btn-outline-primary {
            color: var(--brand) !important;
            border-color: var(--brand) !important;
        }

        .btn-outline-primary:hover {
            background: var(--brand) !important;
            color: #fff !important;
        }

        .btn-success { font-weight: 600; }

        /* ============================================================
           FORMS
           ============================================================ */
        .form-control, .form-select {
            background-color: var(--bg-input) !important;
            border-color: var(--border)       !important;
            color: var(--text)                !important;
            border-radius: var(--r-sm)        !important;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--brand)    !important;
            box-shadow: 0 0 0 3px rgba(var(--brand-rgb),.2) !important;
            background-color: var(--bg-input) !important;
            color: var(--text) !important;
        }

        .form-control::placeholder { color: var(--text-muted); }

        .input-group-text {
            background: var(--bg-input) !important;
            border-color: var(--border) !important;
            color: var(--text-muted)    !important;
        }

        /* ============================================================
           BADGE PRECIO
           ============================================================ */
        .badge-price {
            background: var(--brand-light) !important;
            color: var(--brand) !important;
            border: 1px solid rgba(var(--brand-rgb),.25) !important;
            font-weight: 600;
        }

        /* ============================================================
           HERO
           ============================================================ */
        .hero {
            background:
                radial-gradient(ellipse 70% 60% at 0% 0%, rgba(var(--brand-rgb),.1) 0%, transparent 55%),
                radial-gradient(ellipse 60% 50% at 100% 20%, rgba(249,115,22,.07) 0%, transparent 60%),
                var(--bg);
            border-bottom: 1px solid var(--border);
        }

        .hero-badge {
            display: inline-block;
            background: var(--brand-light);
            color: var(--brand);
            border: 1px solid rgba(var(--brand-rgb),.3);
            font-size: .8rem;
            font-weight: 600;
            padding: .35rem .9rem;
            border-radius: 2rem;
            margin-bottom: 1.25rem;
        }

        /* ============================================================
           SECTION SOFT
           ============================================================ */
        .section-soft {
            background: var(--bg-card);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        /* ============================================================
           ACCORDION
           ============================================================ */
        .accordion-item {
            background: transparent !important;
            border-color: var(--border) !important;
        }

        .accordion-button {
            background: var(--bg-card) !important;
            color: var(--text) !important;
            font-weight: 600 !important;
            box-shadow: none !important;
        }

        .accordion-button:not(.collapsed) {
            color: var(--brand) !important;
            background: var(--brand-light) !important;
        }

        html[data-theme="dark"] .accordion-button::after { filter: invert(1) brightness(1.5); }

        .accordion-body {
            background: var(--bg-card);
            color: var(--text-2);
        }

        /* ============================================================
           TABLES
           ============================================================ */
        .table {
            color: var(--text) !important;
            border-color: var(--border) !important;
        }

        .table > :not(caption) > * > * {
            background-color: transparent !important;
            border-color: var(--border) !important;
            color: var(--text) !important;
        }

        .table-light, .table-light th, .table-light td {
            background: var(--brand-light) !important;
            color: var(--text) !important;
        }

        /* ============================================================
           LIST GROUP
           ============================================================ */
        .list-group-item {
            background: var(--bg-card) !important;
            border-color: var(--border) !important;
            color: var(--text) !important;
        }

        /* ============================================================
           MODALS
           ============================================================ */
        .modal-content {
            background: var(--bg-card) !important;
            border-color: var(--border) !important;
            color: var(--text) !important;
            border-radius: var(--r-lg) !important;
        }

        .modal-header, .modal-footer {
            border-color: var(--border) !important;
        }

        .btn-close { filter: invert(0); }
        html[data-theme="dark"] .btn-close { filter: invert(1); }

        /* ============================================================
           ALERTS
           ============================================================ */
        .alert-danger {
            background: rgba(239,68,68,.1) !important;
            border-color: rgba(239,68,68,.3) !important;
            color: #ef4444 !important;
        }

        .alert-success {
            background: rgba(var(--brand-rgb),.1) !important;
            border-color: rgba(var(--brand-rgb),.3) !important;
            color: var(--brand) !important;
        }

        /* ============================================================
           DROPDOWN (Bootstrap override)
           ============================================================ */
        .dropdown-menu {
            background: var(--bg-card)  !important;
            border-color: var(--border) !important;
            box-shadow: var(--sh-lg)    !important;
            border-radius: var(--r)     !important;
        }

        .dropdown-item {
            color: var(--text) !important;
            border-radius: var(--r-sm);
        }

        .dropdown-item:hover {
            background: var(--brand-light) !important;
            color: var(--brand) !important;
        }

        .dropdown-divider { border-color: var(--border) !important; }

        /* ============================================================
           FOOTER
           ============================================================ */
        .tz-footer {
            background: var(--bg-card);
            border-top: 1px solid var(--border);
            color: var(--text-muted);
            font-size: .875rem;
            padding: 3rem 0 2rem;
        }

        .tz-footer .ft-brand {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--brand);
            margin-bottom: .75rem;
            display: block;
        }

        .tz-footer a {
            color: var(--text-muted);
            transition: color var(--ease);
        }

        .tz-footer a:hover { color: var(--brand); }

        .tz-footer h6 { color: var(--text); font-weight: 600; }

        .tz-footer ul { padding: 0; list-style: none; }
        .tz-footer ul li { margin-bottom: .45rem; }
        .tz-footer ul li a { display: flex; align-items: center; gap: .4rem; }

        .ft-divider {
            border-color: var(--border);
            margin: 2rem 0 1.25rem;
        }

        /* ============================================================
           MOBILE BOTTOM NAV
           ============================================================ */
        .tz-bnav {
            display: none;
            position: fixed;
            bottom: 0; left: 0; right: 0;
            height: var(--bnav-h);
            background: var(--bg-card);
            border-top: 1px solid var(--border);
            z-index: 1080;
            box-shadow: 0 -4px 20px rgba(0,0,0,.08);
        }

        .tz-bnav-inner {
            display: flex;
            height: 100%;
        }

        .tz-bnav a {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 3px;
            font-size: .67rem;
            font-weight: 600;
            color: var(--text-muted);
            text-decoration: none;
            transition: color var(--ease);
            letter-spacing: .02em;
        }

        .tz-bnav a i { font-size: 1.25rem; line-height: 1; }

        .tz-bnav a.active, .tz-bnav a:hover { color: var(--brand); }

        @@media (max-width: 991.98px) { .tz-bnav { display: block; } }

        /* ============================================================
           SHADOW UTIL
           ============================================================ */
        .shadow-soft { box-shadow: var(--sh-md) !important; }

        /* ============================================================
           WA BUTTON
           ============================================================ */
        .btn-whatsapp {
            background: #25d366 !important;
            border-color: #25d366 !important;
            color: #fff !important;
            font-weight: 600;
        }

        .btn-whatsapp:hover {
            background: #1db954 !important;
            border-color: #1db954 !important;
            box-shadow: 0 4px 14px rgba(37,211,102,.35) !important;
        }
    </style>
</head>
<body>

    <!-- ═══════════════════════════ NAVBAR ═══════════════════════════ -->
    <header class="tz-navbar">
        <div class="container tz-inner">

            <!-- Logo -->
            <a class="tz-brand" asp-action="Index" asp-controller="Home">
                <img src="~/img/tazukylogo.jpg" alt="Tazuki">
            </a>

            <!-- Desktop links -->
            <ul class="tz-links">
                <li><a asp-action="Catalogo" asp-controller="Home"><i class="bi bi-grid-3x3-gap"></i> Catálogo</a></li>
                <li>
                    <a href="https://wa.me/5215660776770?text=Hola%2C%20quiero%20informaci%C3%B3n" target="_blank">
                        <i class="bi bi-whatsapp"></i> WhatsApp
                    </a>
                </li>
            </ul>

            <!-- Right cluster -->
            <div class="tz-right">

                <!-- Theme toggle -->
                <button class="tz-ibtn" id="themeToggle" aria-label="Cambiar tema">
                    <i class="bi bi-sun-fill ic-sun"></i>
                    <i class="bi bi-moon-fill ic-moon"></i>
                </button>

                <!-- Cart -->
                <a class="tz-ibtn" asp-controller="Home" asp-action="Carrito" aria-label="Carrito">
                    <i class="bi bi-bag"></i>
                </a>

                <!-- Account dropdown -->
                <div class="tz-drop" id="acctDrop">
                    <button class="tz-ibtn" id="acctBtn" aria-label="Mi cuenta">
                        <i class="bi bi-person"></i>
                    </button>
                    <div class="tz-dmenu">
                        @if (!string.IsNullOrEmpty(ViewBag.Nombre as string))
                        {
                            <div class="dh">Hola, @ViewBag.Nombre</div>
                            <hr />
                        }
                        <a asp-controller="User" asp-action="MisPedidos">
                            <i class="bi bi-box-seam"></i> Mis Pedidos
                        </a>
                        @if (ViewBag.rol == "admin")
                        {
                            <a asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-shield-check"></i> Panel Admin
                            </a>
                        }
                        <hr />
                        @if (!string.IsNullOrEmpty(ViewBag.Nombre as string))
                        {
                            <a asp-controller="Home" asp-action="CerrarSesion">
                                <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Home" asp-action="InicioSesion">
                                <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
                            </a>
                        }
                    </div>
                </div>

                <!-- Hamburger (mobile) -->
                <button class="tz-ham" id="hamBtn" aria-label="Menú">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
    </header>

    <!-- Mobile drawer -->
    <nav class="tz-drawer" id="mobileDrawer">
        <a asp-action="Index" asp-controller="Home"><i class="bi bi-house"></i>Inicio</a>
        <a asp-action="Catalogo" asp-controller="Home"><i class="bi bi-grid-3x3-gap"></i>Catálogo</a>
        <a asp-action="Carrito" asp-controller="Home"><i class="bi bi-bag"></i>Mi Carrito</a>
        <a href="https://wa.me/5215660776770?text=Hola" target="_blank"><i class="bi bi-whatsapp"></i>WhatsApp</a>
        <hr class="dd" />
        <a asp-controller="User" asp-action="MisPedidos"><i class="bi bi-box-seam"></i>Mis Pedidos</a>
        @if (ViewBag.rol == "admin")
        {
            <a asp-controller="Admin" asp-action="Index"><i class="bi bi-shield-check"></i>Panel Admin</a>
        }
        <hr class="dd" />
        @if (!string.IsNullOrEmpty(ViewBag.Nombre as string))
        {
            <a asp-controller="Home" asp-action="CerrarSesion"><i class="bi bi-box-arrow-right"></i>Cerrar Sesión</a>
        }
        else
        {
            <a asp-controller="Home" asp-action="InicioSesion"><i class="bi bi-box-arrow-in-right"></i>Iniciar Sesión</a>
        }
    </nav>

    <!-- ═══════════════════════════ MAIN ═══════════════════════════ -->
    <main>
        @RenderBody()
    </main>

    <!-- ═══════════════════════════ FAQ ═══════════════════════════ -->
    <section id="faq" class="section-soft py-5">
        <div class="container">
            <div class="row g-4 align-items-start">
                <div class="col-lg-6">
                    <h3 class="fw-bold mb-1">Preguntas frecuentes</h3>
