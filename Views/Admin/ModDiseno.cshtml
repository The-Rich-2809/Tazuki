@using System.Data
@{
    Layout = "_LayoutAdmin";
}

@if (TempData["Message"] != null)
{
    <div class="alert @(TempData["Message"]!.ToString()!.StartsWith("Error") ? "alert-danger" : "alert-success") alert-dismissible fade show mb-4" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="adm-page-header">
    <h1><i class="bi bi-pencil-square me-2"></i>Editar Diseño</h1>
    <a asp-controller="Admin" asp-action="ListaDisenos" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Volver a la lista
    </a>
</div>

@if (ViewBag.ErrorMessage != null && ViewBag.ErrorMessage != "")
{
    <div class="alert alert-danger mb-4">@ViewBag.ErrorMessage</div>
}

<div class="card">
    <div class="card-body p-4">
        <form asp-controller="Admin" asp-action="ModDiseno" method="post" enctype="multipart/form-data">
            <input type="hidden" name="Id" value="@ViewBag.Taza[0]" />

            <!-- Modelo -->
            <div class="mb-4">
                <label class="form-label">
                    Modelo
                    <small class="text-muted fw-normal">(identificador único, ej. 00005)</small>
                </label>
                <input type="text" class="form-control" name="modelo"
                       value="@ViewBag.Taza[8]" placeholder="Ej. 00005">
            </div>

            <!-- Nombre -->
            <div class="mb-4">
                <label class="form-label">Nombre del Diseño</label>
                <input type="text" class="form-control" name="nombre"
                       value="@ViewBag.Taza[1]" placeholder="Nombre del diseño" required>
            </div>

            <!-- Etiquetas existentes -->
            <div class="mb-4">
                <label class="form-label">Etiquetas</label>
                <input type="text" id="buscarTag" class="form-control mb-2" placeholder="Filtrar etiquetas…">
                <div id="contenedorTags" class="border rounded p-3" style="max-height:220px;overflow-y:auto;">
                    @{ int tc = 0; }
                    @foreach (DataRow tag in ViewBag.Tags.Rows)
                    {
                        bool marcado = false;
                        foreach (DataRow tt in ViewBag.TT.Rows)
                        {
                            if (tt[1].ToString() == tag[0].ToString())
                            { marcado = true; break; }
                        }
                        <div class="form-check tag-opcion">
                            <input class="form-check-input" type="checkbox" name="tags"
                                   id="tag-@tc" value="@tag[0]" @(marcado ? "checked" : "")>
                            <label class="form-check-label tag-label" for="tag-@tc">@tag[1]</label>
                        </div>
                        tc++;
                    }
                </div>
            </div>

            <!-- Nuevas etiquetas -->
            <div class="mb-4">
                <label class="form-label">
                    Agregar nuevas etiquetas
                    <small class="text-muted fw-normal">(separadas por coma — se crean si no existen)</small>
                </label>
                <input type="text" class="form-control" name="nuevosTags"
                       placeholder="Ej: navidad, animales, abstracto">
            </div>

            <!-- Video actual -->
            <div class="mb-3">
                <label class="form-label">Video actual</label>
                <video class="w-100 rounded" style="max-height:260px;background:#000"
                       autoplay muted loop playsinline controls preload="metadata">
                    <source src="~/@ViewBag.Taza[5]" type="video/mp4" />
                    Tu navegador no soporta video HTML5.
                </video>
            </div>

            <!-- Reemplazar video -->
            <div class="mb-4">
                <label class="form-label">
                    Reemplazar video
                    <small class="text-muted fw-normal">(opcional — deja vacío para conservar el actual)</small>
                </label>
                <input class="form-control" type="file" name="archivo" id="nuevoVideo" accept="video/*">
                <video id="prevNuevoVideo" class="w-100 rounded mt-2 d-none"
                       style="max-height:220px;background:#000"
                       autoplay muted loop playsinline controls></video>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Guardar Cambios
                </button>
                <a asp-controller="Admin" asp-action="ListaDisenos" class="btn btn-outline-secondary">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

<script>
    // Filtro de etiquetas
    document.getElementById('buscarTag').addEventListener('input', function () {
        const q = this.value.toLowerCase();
        document.querySelectorAll('.tag-opcion').forEach(op => {
            const label = op.querySelector('.tag-label')?.textContent.toLowerCase() ?? '';
            op.style.display = label.includes(q) ? '' : 'none';
        });
    });

    // Preview del nuevo video antes de guardar
    document.getElementById('nuevoVideo').addEventListener('change', function () {
        const prev = document.getElementById('prevNuevoVideo');
        if (this.files && this.files[0]) {
            prev.src = URL.createObjectURL(this.files[0]);
            prev.classList.remove('d-none');
        } else {
            prev.src = '';
            prev.classList.add('d-none');
        }
    });
</script>
