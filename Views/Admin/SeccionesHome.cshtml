@using System.Data
@{
    Layout = "_LayoutAdmin";
    var secciones = (DataTable)ViewBag.Secciones;
}

<div class="adm-page-header">
    <div>
        <h1>Secciones del Inicio</h1>
        <p class="text-secondary mb-0">Gestiona los apartados de diseños de temporada que aparecen en la página de inicio.</p>
    </div>
    <a asp-controller="Home" asp-action="Index" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-3">
        <i class="bi bi-eye me-1"></i>Ver Inicio
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h6 class="fw-semibold mb-3"><i class="bi bi-plus-circle me-2" style="color:var(--brand)"></i>Nueva sección</h6>
        <form asp-action="AgregarSeccion" asp-controller="Admin" method="post" class="d-flex gap-2">
            <input type="text" name="nombre" class="form-control" placeholder="Ej: Diseños de Navidad, San Valentín…" required>
            <button type="submit" class="btn btn-primary px-4 text-nowrap">
                <i class="bi bi-plus-lg me-1"></i>Agregar
            </button>
        </form>
    </div>
</div>

@if (secciones.Rows.Count == 0)
{
    <div class="text-center py-5" style="color:var(--text-muted)">
        <i class="bi bi-layout-text-window-reverse" style="font-size:3rem; opacity:.3"></i>
        <p class="mt-3">Aún no has creado ninguna sección. Agrega una arriba para comenzar.</p>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width:60px">Orden</th>
                        <th>Nombre</th>
                        <th style="width:110px" class="text-center">Diseños</th>
                        <th style="width:100px" class="text-center">Estado</th>
                        <th style="width:200px" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DataRow seccion in secciones.Rows)
                    {
                        bool activo = Convert.ToBoolean(seccion["activo"]);
                        <tr>
                            <td class="align-middle text-muted">@seccion["orden"]</td>
                            <td class="align-middle fw-semibold">@seccion["nombre"]</td>
                            <td class="align-middle text-center">
                                <span class="badge rounded-pill" style="background:var(--brand-light);color:var(--brand);border:1px solid rgba(var(--brand-rgb),.25)">
                                    @seccion["total_disenos"] diseños
                                </span>
                            </td>
                            <td class="align-middle text-center">
                                @if (activo)
                                {
                                    <span class="badge bg-success">Activa</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactiva</span>
                                }
                            </td>
                            <td class="align-middle text-end">
                                <a href="@Url.Action("EditarSeccion", "Admin", new { id = seccion["id"] })"
                                   class="btn btn-sm btn-primary">
                                    <i class="bi bi-pencil"></i> Editar
                                </a>
                                <a href="@Url.Action("ToggleSeccion", "Admin", new { id = seccion["id"], activo = !activo })"
                                   class="btn btn-sm @(activo ? "btn-warning" : "btn-success")">
                                    <i class="bi @(activo ? "bi-pause-fill" : "bi-play-fill")"></i>
                                    @(activo ? "Desactivar" : "Activar")
                                </a>
                                <a href="@Url.Action("EliminarSeccion", "Admin", new { id = seccion["id"] })"
                                   class="btn btn-sm btn-danger"
                                   onclick="return confirm('¿Eliminar la sección «@seccion["nombre"]»? Se perderán los diseños asignados.')">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
