@{
    Layout = "_LayoutAdmin";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --primary-color: #4B92DB;
        --primary-hover-color: #3a7cc0;
        --background-color: #f0f2f5;
        --container-bg-color: #ffffff;
        --text-color: #495057;
        --font-family: 'Poppins', sans-serif;
    }

    body {
        background-color: var(--background-color);
        font-family: var(--font-family);
        color: var(--text-color);
    }

    .container {
        max-width: 800px;
        margin-top: 50px;
        margin-bottom: 50px;
        background-color: var(--container-bg-color);
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    }

    h1 {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--primary-color);
        margin-bottom: 30px;
        text-align: center;
    }

    .form-label { font-weight: 600; }

    .form-control {
        border-radius: 8px;
        padding: 12px;
        font-size: 1rem;
    }

    .btn-primary {
        background-color: var(--primary-color);
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 8px;
        margin-top: 20px;
        width: 100%;
        font-weight: 600;
        transition: background-color 0.3s;
    }

    .btn-primary:hover { background-color: var(--primary-hover-color); }

    /* Overlay de carga */
    #loadingOverlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.7);
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 10000;
    }

    #loadingOverlay .spinner-border {
        width: 3.5rem;
        height: 3.5rem;
        border-width: 0.4em;
    }

    #loadingText {
        margin-top: 1rem;
        font-size: 1.1rem;
        font-weight: 600;
        color: #fff;
        text-align: center;
        max-width: 320px;
    }

    #loadingSubtext {
        font-size: 0.85rem;
        color: rgba(255,255,255,0.7);
        margin-top: 0.25rem;
    }

    /* Overlay de confirmación */
    #confirmOverlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .confirm-box {
        background: #fff;
        padding: 32px;
        border-radius: 12px;
        max-width: 600px;
        width: 92%;
        max-height: 85vh;
        overflow-y: auto;
        box-shadow: 0 20px 40px rgba(0,0,0,0.2);
    }

    .confirm-box h5 {
        font-weight: 700;
        color: var(--primary-color);
        margin-bottom: 1rem;
    }

    .file-counter {
        font-size: 0.82rem;
        color: #6c757d;
        font-weight: 500;
        margin-bottom: 0.5rem;
    }
</style>

<!-- Overlay de carga -->
<div id="loadingOverlay">
    <div class="spinner-border text-light" role="status"></div>
    <p id="loadingText">Procesando...</p>
    <p id="loadingSubtext"></p>
</div>

<!-- Overlay de confirmación -->
<div id="confirmOverlay">
    <div class="confirm-box">
        <p id="fileCounter" class="file-counter"></p>
        <div id="alertContent"></div>
        <div class="d-flex gap-2 mt-4">
            <button id="btnSaltar" class="btn btn-secondary flex-fill">Saltar</button>
            <button id="btnGuardar" class="btn btn-primary flex-fill mt-0">Guardar Diseño</button>
        </div>
    </div>
</div>

<div class="container">
    <h1>Agregar Nuevo Diseño</h1>

    <div id="mensajesResultado"></div>

    <form id="uploadForm">
        <div class="mb-4">
            <label class="form-label">Video(s) del Diseño</label>
            <input class="form-control" type="file" id="archivoInput" accept="video/*" multiple required>
            <small class="text-muted mt-1 d-block">Puedes seleccionar varios videos a la vez. Se procesarán uno por uno.</small>
        </div>
        <button type="submit" id="btnAnalizar" class="btn btn-primary">Analizar Diseño(s)</button>
    </form>
</div>

<script>
    const uploadForm      = document.getElementById('uploadForm');
    const archivoInput    = document.getElementById('archivoInput');
    const loadingOverlay  = document.getElementById('loadingOverlay');
    const loadingText     = document.getElementById('loadingText');
    const loadingSubtext  = document.getElementById('loadingSubtext');
    const confirmOverlay  = document.getElementById('confirmOverlay');
    const alertContent    = document.getElementById('alertContent');
    const fileCounter     = document.getElementById('fileCounter');
    const mensajes        = document.getElementById('mensajesResultado');
    const btnGuardar      = document.getElementById('btnGuardar');
    const btnSaltar       = document.getElementById('btnSaltar');

    let fileQueue    = [];
    let currentIndex = 0;
    let savedCount   = 0;
    let skippedCount = 0;

    // ── Utilidades ──────────────────────────────────────────────

    function showLoading(texto, subtexto = '') {
        loadingText.textContent    = texto;
        loadingSubtext.textContent = subtexto;
        loadingOverlay.style.display = 'flex';
    }

    function hideLoading() {
        loadingOverlay.style.display = 'none';
    }

    function showConfirm(html) {
        const total = fileQueue.length;
        fileCounter.textContent = total > 1
            ? `Archivo ${currentIndex + 1} de ${total}: ${fileQueue[currentIndex].name}`
            : fileQueue[currentIndex].name;
        alertContent.innerHTML = html;
        confirmOverlay.style.display = 'flex';
    }

    function hideConfirm() {
        confirmOverlay.style.display = 'none';
        alertContent.innerHTML = '';
    }

    function addMensaje(tipo, texto) {
        mensajes.insertAdjacentHTML('beforeend',
            `<div class="alert alert-${tipo} mt-2">${texto}</div>`);
    }

    // ── Cola de archivos ─────────────────────────────────────────

    function avanzar() {
        currentIndex++;
        if (currentIndex < fileQueue.length) {
            processFile(currentIndex);
        } else {
            terminar();
        }
    }

    function terminar() {
        hideConfirm();
        if (fileQueue.length > 1) {
            addMensaje('success',
                `Proceso completado: <strong>${savedCount}</strong> guardado(s), <strong>${skippedCount}</strong> saltado(s).`);
        }
        uploadForm.reset();
        fileQueue    = [];
        currentIndex = 0;
        savedCount   = 0;
        skippedCount = 0;
    }

    async function processFile(index) {
        const file  = fileQueue[index];
        const total = fileQueue.length;

        showLoading(
            `Analizando video${total > 1 ? ` (${index + 1} de ${total})` : ''}...`,
            file.name
        );

        const formData = new FormData();
        formData.append('archivo', file);

        try {
            const response = await fetch('@Url.Action("AgregarDisenoArchivo", "Admin")', {
                method: 'POST',
                body: formData
            });

            const html = await response.text();
            hideLoading();

            if (!response.ok) {
                addMensaje('danger', `Error del servidor al analizar "${file.name}".`);
                avanzar();
                return;
            }

            showConfirm(html);

        } catch (err) {
            hideLoading();
            addMensaje('danger', `Error de red al analizar "${file.name}": ${err.message}`);
            avanzar();
        }
    }

    // ── Eventos ──────────────────────────────────────────────────

    uploadForm.addEventListener('submit', function (e) {
        e.preventDefault();
        fileQueue = Array.from(archivoInput.files);
        if (fileQueue.length === 0) return;

        currentIndex = 0;
        savedCount   = 0;
        skippedCount = 0;
        mensajes.innerHTML = '';

        processFile(0);
    });

    btnGuardar.addEventListener('click', async function () {
        const file = fileQueue[currentIndex];
        hideConfirm();
        showLoading('Guardando diseño...', file.name);

        try {
            const response = await fetch('@Url.Action("GuardarDisenoConfirmado", "Admin")', {
                method: 'POST'
            });

            const result = await response.json();
            hideLoading();

            if (result.success) {
                savedCount++;
                addMensaje('success', `"${file.name}" guardado correctamente.`);
            } else {
                addMensaje('danger', `Error al guardar "${file.name}": ${result.message}`);
            }

        } catch (err) {
            hideLoading();
            addMensaje('danger', `Error al guardar "${file.name}": ${err.message}`);
        }

        avanzar();
    });

    btnSaltar.addEventListener('click', function () {
        skippedCount++;
        hideConfirm();
        avanzar();
    });
</script>
