@using System.Data
@{
    var secciones          = ViewBag.Secciones as DataTable;
    var seccionDisenos     = ViewBag.SeccionDisenos as DataTable;
    var disenosAleatorios  = ViewBag.DisenosAleatorios as DataTable;

    Layout = "_LayoutUsuario";
}
@section Head {
    <link rel="icon" href="@Url.Content("~/img/tazukilogo.png")">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}
<head>
    <title>Tazuki – Tazas sublimadas personalizadas</title>
</head>

<style>
    /* ── Hero ── */
    .idx-hero {
        background:
            radial-gradient(ellipse 70% 60% at 0% 0%, rgba(var(--brand-rgb),.12) 0%, transparent 55%),
            radial-gradient(ellipse 55% 45% at 100% 20%, rgba(249,115,22,.08) 0%, transparent 60%),
            var(--bg);
        border-bottom: 1px solid var(--border);
        padding: 4rem 0 3.5rem;
    }
    .idx-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: var(--brand-light);
        color: var(--brand);
        border: 1px solid rgba(var(--brand-rgb),.3);
        font-size: .78rem;
        font-weight: 600;
        padding: .3rem .9rem;
        border-radius: 2rem;
        margin-bottom: 1.25rem;
    }
    .idx-hero h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); line-height: 1.2; }

    /* ── Sections ── */
    .idx-section { padding: 3rem 0; border-bottom: 1px solid var(--border); }
    .idx-section:last-child { border-bottom: none; }
    .idx-section-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: .5rem;
    }
    .idx-section-header h2 { font-size: 1.4rem; margin: 0; }
    .idx-ver-todo {
        color: var(--text-muted);
        font-size: .85rem;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        transition: color .18s;
    }
    .idx-ver-todo:hover { color: var(--brand); }

    /* ── Design Cards ── */
    .idx-card-wrap {
        position: relative;
        overflow: hidden;
        border-radius: var(--r) var(--r) 0 0;
        background: #111;
        aspect-ratio: 3/4;
    }
    .idx-card-wrap video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .idx-card-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background .22s;
    }
    .idx-card-wrap:hover .idx-card-overlay { background: rgba(0,0,0,.42); }
    .idx-card-overlay-text {
        color: #fff;
        font-size: .85rem;
        font-weight: 600;
        opacity: 0;
        transform: translateY(6px);
        transition: opacity .22s, transform .22s;
        display: flex;
        align-items: center;
        gap: .35rem;
    }
    .idx-card-wrap:hover .idx-card-overlay-text { opacity: 1; transform: translateY(0); }

    .badge-price {
        background: var(--brand-light) !important;
        color: var(--brand) !important;
        border: 1px solid rgba(var(--brand-rgb),.25) !important;
        font-weight: 600;
        font-size: .75rem;
        white-space: nowrap;
    }

    /* precio + botón en tarjetas pequeñas */
    .idx-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .4rem;
        margin-top: auto;
    }
    @media (max-width: 400px) {
        .idx-card-footer .btn { padding-left: .5rem; padding-right: .5rem; font-size: .75rem; }
    }

    /* ── CTA Band ── */
    .idx-cta-band {
        background: var(--brand);
        color: #fff;
        padding: 3rem 0;
        text-align: center;
    }
    .idx-cta-band h2 { color: #fff; font-size: 1.6rem; }
    .idx-cta-band p { color: rgba(255,255,255,.82); }
    .idx-cta-band .btn-light {
        background: #fff;
        color: var(--brand);
        font-weight: 700;
        border: none;
    }
    .idx-cta-band .btn-light:hover { background: rgba(255,255,255,.9); }
</style>

<!-- ═══════════════════ HERO ═══════════════════ -->
<header class="idx-hero">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-6 order-lg-1">
                <div class="idx-hero-badge">
                    <i class="bi bi-stars"></i> Personaliza desde 1 pieza
                </div>
                <h1 class="fw-bold mb-3">
                    Tazas sublimadas <span style="color:var(--brand)">listas para regalar</span>
                </h1>
                <p class="lead mb-4" style="color:var(--text-2)">
                    Diseños a tu medida para eventos, marcas y ocasiones especiales.
                    Fabricación rápida y envíos a todo México.
                </p>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="@Url.Action("Catalogo", "Home")" class="btn btn-primary btn-lg px-4">
                        <i class="bi bi-grid-3x3-gap me-1"></i>Ver catálogo
                    </a>
                    <a href="https://wa.me/5215660776770?text=Hola%2C%20quiero%20informaci%C3%B3n" target="_blank"
                       class="btn btn-outline-primary btn-lg px-4">
                        <i class="bi bi-whatsapp me-1"></i>WhatsApp
                    </a>
                </div>
                <div class="d-flex gap-4 mt-4 small" style="color:var(--text-muted)">
                    <div><i class="bi bi-check-circle-fill me-1" style="color:var(--brand)"></i>Entrega 24–72 h</div>
                    <div><i class="bi bi-check-circle-fill me-1" style="color:var(--brand)"></i>Mayoreo</div>
                </div>
            </div>
            <div class="col-lg-6 order-lg-2">
                <img class="img-fluid rounded-4 shadow-soft" alt="Tazas sublimadas" src="~/img/taza2.jpg" />
            </div>
        </div>
    </div>
</header>

<!-- ═══════════════════ DISEÑOS ALEATORIOS ═══════════════════ -->
@if (disenosAleatorios != null && disenosAleatorios.Rows.Count > 0)
{
    <section class="idx-section">
        <div class="container">
            <div class="idx-section-header">
                <h2 class="fw-bold">Descubre más diseños</h2>
                <a href="@Url.Action("Catalogo", "Home")" class="idx-ver-todo">
                    Ver catálogo completo <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="row g-3">
                @foreach (DataRow diseno in disenosAleatorios.Rows)
                {
                    string dId      = diseno["id"].ToString()!;
                    string dNombre  = diseno["nombre"]?.ToString() ?? "";
                    string dPrecio  = diseno["precio"]?.ToString() ?? "";
                    string dRuta    = diseno["ruta_diseno"]?.ToString() ?? "";
                    string dModelo  = diseno["modelo"]?.ToString() ?? "";
                    string dTags    = diseno["tags_nombres"] != DBNull.Value ? diseno["tags_nombres"].ToString()! : "";
                    var    tagArr   = dTags.Split('|', StringSplitOptions.RemoveEmptyEntries);
                    string url      = Url.Action("Producto", "Home", new { Id = dId })!;

                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="card h-100">
                            <div class="idx-card-wrap">
                                <a href="@url">
                                    <video class="idx-card-video" muted loop playsinline preload="none">
                                        <source src="@Url.Content("~/" + dRuta)" type="video/mp4" />
                                    </video>
                                </a>
                                <div class="idx-card-overlay" style="pointer-events:none">
                                    <span class="idx-card-overlay-text">
                                        <i class="bi bi-eye-fill"></i> Ver diseño
                                    </span>
                                </div>
                            </div>
                            <div class="card-body d-flex flex-column py-2 px-3">
                                @if (!string.IsNullOrWhiteSpace(dModelo))
                                {
                                    <span class="badge bg-secondary mb-1" style="font-size:.65rem;width:fit-content">Mod. @dModelo</span>
                                }
                                <a href="@url" class="text-decoration-none text-reset">
                                    <h6 class="fw-bold mb-1" style="font-size:.85rem;line-height:1.3">@dNombre</h6>
                                </a>
                                @if (tagArr.Length > 0)
                                {
                                    <div class="mb-2">
                                        @foreach (var tag in tagArr.Take(3))
                                        {
                                            <span class="badge rounded-pill bg-light text-dark fw-normal me-1 mb-1" style="font-size:.65rem">@tag.Trim()</span>
                                        }
                                    </div>
                                }
                                <div class="idx-card-footer">
                                    <span class="badge rounded-pill badge-price">Desde $@dPrecio</span>
                                    <a href="@url" class="btn btn-primary btn-sm px-3">Comprar</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- ═══════════════════ SECCIONES DINÁMICAS ═══════════════════ -->
@if (secciones != null && secciones.Rows.Count > 0)
{
    foreach (DataRow seccion in secciones.Rows)
    {
        string seccionId = seccion["id"].ToString()!;
        var disenos = seccionDisenos!.AsEnumerable()
            .Where(r => r["seccion_id"].ToString() == seccionId)
            .ToList();

        if (disenos.Count == 0) continue;

        <section class="idx-section">
            <div class="container">
                <div class="idx-section-header">
                    <h2 class="fw-bold">@seccion["nombre"]</h2>
                    <a href="@Url.Action("Catalogo", "Home")" class="idx-ver-todo">
                        Ver catálogo completo <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
                <div class="row g-3" id="sec-grid-@seccionId">
                    @foreach (var diseno in disenos)
                    {
                        string dId   = diseno["diseno_id"].ToString()!;
                        string dNombre = diseno["nombre"]?.ToString() ?? "";
                        string dPrecio = diseno["precio"]?.ToString() ?? "";
                        string dRuta   = diseno["ruta_diseno"]?.ToString() ?? "";
                        string dModelo = diseno["modelo"]?.ToString() ?? "";
                        string dTags   = diseno["tags_nombres"] != DBNull.Value
                            ? diseno["tags_nombres"].ToString()! : "";
                        var tagArr = dTags.Split('|', StringSplitOptions.RemoveEmptyEntries);
                        string productoUrl = Url.Action("Producto", "Home", new { Id = dId })!;

                        <div class="col-6 col-md-4 col-lg-3">
                            <div class="card h-100">
                                <div class="idx-card-wrap">
                                    <a href="@productoUrl">
                                        <video class="idx-card-video" muted loop playsinline preload="none">
                                            <source src="@Url.Content("~/" + dRuta)" type="video/mp4" />
                                        </video>
                                    </a>
                                    <div class="idx-card-overlay" style="pointer-events:none">
                                        <span class="idx-card-overlay-text">
                                            <i class="bi bi-eye-fill"></i> Ver diseño
                                        </span>
                                    </div>
                                </div>
                                <div class="card-body d-flex flex-column py-2 px-3">
                                    @if (!string.IsNullOrWhiteSpace(dModelo))
                                    {
                                        <span class="badge bg-secondary mb-1" style="font-size:.65rem;width:fit-content">Mod. @dModelo</span>
                                    }
                                    <a href="@productoUrl" class="text-decoration-none text-reset">
                                        <h6 class="fw-bold mb-1" style="font-size:.85rem;line-height:1.3">@dNombre</h6>
                                    </a>
                                    @if (tagArr.Length > 0)
                                    {
                                        <div class="mb-2">
                                            @foreach (var tag in tagArr.Take(3))
                                            {
                                                <span class="badge rounded-pill bg-light text-dark fw-normal me-1 mb-1" style="font-size:.65rem">@tag.Trim()</span>
                                            }
                                        </div>
                                    }
                                    <div class="idx-card-footer">
                                        <span class="badge rounded-pill badge-price">Desde $@dPrecio</span>
                                        <a href="@productoUrl" class="btn btn-primary btn-sm px-3">Comprar</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
}
else
{
    <!-- Sin secciones configuradas: sólo se muestra el hero con link al catálogo -->
    <section class="py-5 text-center">
        <div class="container">
            <p class="text-secondary mb-4">Próximamente habrá diseños de temporada disponibles aquí.</p>
            <a href="@Url.Action("Catalogo", "Home")" class="btn btn-primary btn-lg px-5">
                <i class="bi bi-grid-3x3-gap me-2"></i>Ver catálogo completo
            </a>
        </div>
    </section>
}

<!-- ═══════════════════ BANDA CTA ═══════════════════ -->
<div class="idx-cta-band">
    <div class="container">
        <h2 class="fw-bold mb-2">¿Tienes un diseño propio?</h2>
        <p class="mb-4">Cuéntanos cantidades, colores y frases. Hacemos sublimación a tu medida.</p>
        <a href="https://wa.me/5215660776770?text=Hola%2C%20quiero%20personalizar%20una%20taza" target="_blank"
           class="btn btn-light btn-lg px-5 rounded-pill">
            <i class="bi bi-whatsapp me-2"></i>Escribir por WhatsApp
        </a>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const obs = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            const v = entry.target;
            if (entry.isIntersecting) {
                if (v.readyState === 0) v.load();
                v.play().catch(() => {});
            } else {
                v.pause();
            }
        });
    }, { rootMargin: '200px 0px', threshold: 0.1 });

    document.querySelectorAll('.idx-card-video').forEach(v => obs.observe(v));
});
</script>
