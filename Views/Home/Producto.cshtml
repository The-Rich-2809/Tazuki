@using System.Data
@{
    if (ViewBag.Activo == "1")
    {
        Layout = "_LayoutUsuario";
    }
}
@section Head {
    <link rel="icon" href="@Url.Content("~/img/tazukilogo.png")">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] Tazuky Producto</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --custom-main-color: var(--brand, #3bbfad);
            --custom-dark:       var(--text, #343a40);
            --custom-light-grey: var(--border, #e9ecef);
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--bg, #f0f2f5);
            padding: 2rem 0;
        }

        .product-card {
            background-color: var(--bg-card, #ffffff);
            border: 1px solid var(--border, #e9ecef);
            border-radius: 1rem;
            padding: 1.5rem;
            box-shadow: var(--sh-md, 0 8px 16px rgba(0,0,0,0.08));
        }

        .main-product-video {
            width: 100%;
            border-radius: 0.75rem;
            border: 1px solid var(--border, #e9ecef);
            background-color: #000;
        }

        .product-title {
            font-size: 1.75rem;
            font-weight: 600;
            color: var(--text, #343a40);
            margin-bottom: 0.5rem;
        }

        .price-new {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--text, #343a40);
            line-height: 1;
        }

        .btn-add-cart {
            font-weight: 600;
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
            font-size: 1rem;
            background-color: var(--bg-card, #fff);
            color: var(--brand, #3bbfad);
            border: 2px solid var(--brand, #3bbfad);
            transition: all 0.3s ease;
        }

        .btn-add-cart:hover {
            background-color: var(--brand, #3bbfad);
            color: #fff;
        }

        .color-selector .color-btn {
            border: 2px solid var(--border, #e0e0e0);
            background-color: var(--bg-card, #ffffff);
            color: var(--text-2, #333);
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            cursor: pointer;
            font-weight: 500;
            margin-right: 0.5rem;
            transition: all 0.2s ease;
        }

        .color-selector .color-btn.active {
            background-color: var(--brand, #6c757d);
            color: #ffffff;
            border-color: var(--brand, #6c757d);
            font-weight: 600;
        }

        .video-container {
            position: relative;
            cursor: pointer;
            border-radius: 0.75rem;
            overflow: hidden;
        }

        .video-overlay-message {
            position: absolute;
            bottom: 1rem;
            left: 50%;
            transform: translateX(-50%);
            background-color: rgba(0, 0, 0, 0.6);
            color: #ffffff;
            padding: 0.5rem 1.2rem;
            border-radius: 2rem;
            font-size: 0.9rem;
            font-weight: 500;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.4s ease;
            z-index: 10;
            white-space: nowrap;
        }

        .video-overlay-message.visible {
            opacity: 1;
        }

        .quantity-selector {
            max-width: 150px;
            display: flex;
        }

        .quantity-selector .btn-quantity {
            background-color: var(--bg-card, #fff);
            border: 2px solid var(--brand, #3bbfad);
            color: var(--brand, #3bbfad);
            font-weight: 700;
            font-size: 1rem;
            padding: 0.5rem;
            width: 40px;
            height: 40px;
            cursor: pointer;
        }

        .quantity-selector #quantity-input {
            width: 50px;
            height: 40px;
            text-align: center;
            border: 2px solid var(--brand, #3bbfad);
            border-left: none;
            border-right: none;
            font-weight: 600;
            background-color: var(--bg-card, #fff);
            color: var(--text, #343a40);
        }

        .tag-link {
            cursor: pointer;
            transition: background-color 0.2s ease, color 0.2s ease;
        }
        .tag-link:hover {
            background-color: var(--brand, #3bbfad) !important;
            color: white !important;
        }

        /* ── Carrusel de sugerencias ── */
        .sugerencias-section {
            padding-bottom: 3rem;
        }

        .sugerencias-wrapper {
            position: relative;
        }

        .sugerencias-track {
            display: flex;
            gap: 1rem;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
            padding: 0.5rem 0.25rem 1rem;
            scroll-behavior: smooth;
        }

        .sugerencias-track::-webkit-scrollbar { display: none; }

        /* ── Tarjeta de sugerencia (igual al catálogo) ── */
        .sug-card-wrap {
            flex: 0 0 calc(33.333% - 0.667rem);
            scroll-snap-align: start;
            min-width: 0;
        }

        .sug-card-wrap video.card-img-top {
            height: 200px;
            object-fit: contain;
            background-color: var(--bg, #f8f9fa);
        }

        /* Overlay de hover igual al catálogo */
        .video-card-wrap {
            position: relative;
            overflow: hidden;
            border-radius: var(--r, .75rem) var(--r, .75rem) 0 0;
        }

        .video-card-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,.42);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity .25s ease;
            pointer-events: none;
        }

        .video-card-wrap:hover .video-card-overlay { opacity: 1; }

        .video-card-overlay-text {
            color: #fff;
            font-weight: 600;
            font-size: .95rem;
            background: rgba(255,255,255,.15);
            border: 1.5px solid rgba(255,255,255,.75);
            padding: .5rem 1.4rem;
            border-radius: 2rem;
            display: flex;
            align-items: center;
            gap: .45rem;
            backdrop-filter: blur(4px);
        }

        .btn-ver-diseno {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .4rem;
            width: 100%;
            padding: .5rem 1rem;
            font-size: .875rem;
            font-weight: 600;
            color: var(--brand, #4DB6AC);
            border: 1.5px solid var(--brand, #4DB6AC);
            background: transparent;
            border-radius: var(--r-sm, .5rem);
            text-decoration: none;
            transition: background .2s ease, color .2s ease;
        }

        .btn-ver-diseno:hover {
            background: var(--brand, #4DB6AC);
            color: #fff;
        }

        .tag-filter-btn {
            cursor: pointer;
            transition: background-color 0.2s ease, color 0.2s ease;
        }

        .tag-filter-btn:hover {
            background-color: var(--brand, #4DB6AC) !important;
            color: white !important;
        }

        /* ── Flechas del carrusel ── */
        .carousel-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-60%);
            z-index: 10;
            background: var(--bg-card, #fff);
            border: 1.5px solid var(--border, #ddd);
            border-radius: 50%;
            width: 42px;
            height: 42px;
            font-size: 1.5rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--brand, #3bbfad);
            transition: background 0.2s, color 0.2s, border-color 0.2s;
            box-shadow: 0 2px 8px rgba(0,0,0,0.10);
            line-height: 1;
            padding: 0;
        }

        .carousel-arrow:hover {
            background: var(--brand, #3bbfad);
            color: #fff;
            border-color: var(--brand, #3bbfad);
        }

        .carousel-arrow.left { left: -22px; }
        .carousel-arrow.right { right: -22px; }

        @@media (max-width: 768px) {
            .sug-card-wrap { flex: 0 0 calc(50% - 0.5rem); }
            .carousel-arrow { display: none; }
        }

        @@media (max-width: 480px) {
            .sug-card-wrap { flex: 0 0 calc(80% - 0.5rem); }
        }
    </style>
</head>

<body>
    <div class="container my-4">
        <div class="product-card">
            <div class="row g-3">
                <div class="col-md-7">
                    <div class="video-container" id="video-container">
                        <video id="product-video" class="main-product-video" autoplay loop playsinline preload="metadata">
                            <source src="@Url.Content("~/" + ViewBag.Taza[5])" type="video/mp4">
                            Tu navegador no soporta la etiqueta de video.
                        </video>
                        <div id="video-mute-message" class="video-overlay-message">
                            Click para silenciar
                        </div>
                    </div>
                </div>

                <form asp-action="Producto" asp-controller="Home" method="post" class="col-md-5">
                    <input type="hidden" name="Id_Taza" value="@ViewBag.Taza[0]" />
                    @{
                        var firstRow = (ViewBag.Tamanos != null && ViewBag.Tamanos.Rows.Count > 0) ? ViewBag.Tamanos.Rows[0] : null;
                        string initialPrice = firstRow != null ? firstRow[2].ToString() : ViewBag.Taza[2].ToString();
                        string initialName = firstRow != null ? firstRow[1].ToString() : "No disponible";
                        string initialId = firstRow != null ? firstRow[0].ToString() : ViewBag.Taza[0].ToString();
                    }

                    <input name="Id_Tamano" type="hidden" id="product-id" value="@initialId" />
                    @if (!string.IsNullOrWhiteSpace(ViewBag.Taza[8]?.ToString()))
                    {
                        <span class="badge bg-secondary mb-2 d-inline-block">Modelo: @ViewBag.Taza[8]</span>
                    }
                    <h1 class="product-title mb-2">@ViewBag.Taza[1]</h1>

                    <div class="mb-3">
                        <span class="price-new">$<span id="product-price">@initialPrice</span></span>
                    </div>

                    <div class="mb-3">
                        <h5 class="fw-bold small">Tamaño seleccionado: <span id="selected-color-name">@initialName</span></h5>
                        <div class="color-selector">
                            @for (int i = 0; i < ViewBag.Tamanos.Rows.Count; i++)
                            {
                                var row = ViewBag.Tamanos.Rows[i];
                                <button class="color-btn @(i == 0 ? "active" : "")" 
                                        data-price="@row[2]" 
                                        data-color-name="@row[1]" 
                                        data-id="@row[0]" type="button">
                                    @row[1]
                                </button>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <h5 class="fw-bold small">Características:</h5>
                        @for (int o = 0; o < ViewBag.Count_Tags; o++)
                        {
                            var tagVal = ViewBag.Tags_Taza[o].ToString().ToLower();
                            <a href="@Url.Action("Catalogo", "Home")?tag=@tagVal"
                               class="badge rounded-pill bg-light text-dark fw-normal me-1 mb-1 text-decoration-none tag-link"
                               title="Ver diseños con '@ViewBag.Tags_Taza[o]'">@ViewBag.Tags_Taza[o]</a>
                        }
                    </div>

                    <div class="mb-3">
                        <h5 class="fw-bold small">Cantidad:</h5>
                        <div class="quantity-selector">
                            <button class="btn-quantity" id="quantity-minus" type="button">-</button>
                            <input name="Cantidad" type="text" id="quantity-input" class="form-control text-center" value="1" readonly>
                            <button class="btn-quantity" id="quantity-plus" type="button">+</button>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <button class="btn btn-add-cart" type="submit">Agregar al carrito</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (ViewBag.Sugerencias != null && ((DataTable)ViewBag.Sugerencias).Rows.Count > 0)
    {
        <section class="sugerencias-section container">
            <h4 class="fw-bold mb-3">También te puede gustar</h4>
            <div class="sugerencias-wrapper">
                <button class="carousel-arrow left" id="arrow-left" disabled>&#8249;</button>

                <div class="sugerencias-track" id="sugerencias-track">
                    @foreach (System.Data.DataRow sug in ((DataTable)ViewBag.Sugerencias).Rows)
                    {
                        var sugUrl = Url.Action("Producto", "Home", new { Id = sug["id"] });
                        var sugTags = (sug["tags_nombres"] != DBNull.Value ? sug["tags_nombres"].ToString() : "").Split('|', StringSplitOptions.RemoveEmptyEntries);

                        <div class="sug-card-wrap">
                            <div class="card h-100 shadow-sm border-0">
                                <div class="video-card-wrap">
                                    <a href="@sugUrl">
                                        <video class="card-img-top" muted loop playsinline preload="none">
                                            <source src="@Url.Content("~/" + sug["ruta_diseno"].ToString())" type="video/mp4" />
                                        </video>
                                    </a>
                                    <div class="video-card-overlay">
                                        <span class="video-card-overlay-text">
                                            <i class="bi bi-eye-fill"></i> Ver diseño
                                        </span>
                                    </div>
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <div>
                                            @if (!string.IsNullOrWhiteSpace(sug["modelo"]?.ToString()))
                                            {
                                                <span class="badge bg-secondary mb-1 d-inline-block" style="font-size:.7rem">Mod. @sug["modelo"]</span>
                                            }
                                            <a href="@sugUrl" class="text-decoration-none text-reset">
                                                <h5 class="card-title fw-bold mb-0">@sug["nombre"]</h5>
                                            </a>
                                        </div>
                                        <span class="badge rounded-pill badge-price fs-6">$@sug["precio"]</span>
                                    </div>
                                    <div class="mb-3">
                                        @foreach (var tag in sugTags)
                                        {
                                            <a href="@Url.Action("Catalogo", "Home")?tag=@tag.ToLower().Trim()"
                                               class="badge rounded-pill bg-light text-dark fw-normal me-1 mb-1 text-decoration-none tag-filter-btn">
                                                @tag.Trim()
                                            </a>
                                        }
                                    </div>
                                    <div class="mt-auto pt-1">
                                        <a href="@sugUrl" class="btn-ver-diseno">
                                            <i class="bi bi-bag-plus"></i> Ver diseño
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <button class="carousel-arrow right" id="arrow-right">&#8250;</button>
            </div>
        </section>
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const video = document.getElementById('product-video');
            const videoContainer = document.getElementById('video-container');
            const muteMessage = document.getElementById('video-mute-message');
            
            let hideTimer = null;

            function showMessage(text, persist = false) {
                clearTimeout(hideTimer);
                muteMessage.textContent = text;
                muteMessage.classList.add('visible');
                if (!persist) {
                    hideTimer = setTimeout(() => muteMessage.classList.remove('visible'), 1800);
                }
            }

            function hideMessage() {
                clearTimeout(hideTimer);
                muteMessage.classList.remove('visible');
            }

            // Intentar reproducir con sonido al entrar
            video.muted = false;
            video.play()
                .then(() => {
                    // Sonido activo — avisa brevemente y oculta
                    showMessage('🔊 Con sonido');
                })
                .catch(() => {
                    // Navegador bloqueó el audio automático — pide al usuario que haga click
                    video.muted = true;
                    video.play();
                    showMessage('🔇 Click para activar sonido', true);
                });

            // Click en el video: mute/unmute
            videoContainer.addEventListener('click', function () {
                video.muted = !video.muted;
                if (video.muted) {
                    showMessage('🔇 Silenciado');
                } else {
                    showMessage('🔊 Con sonido');
                }
            });

            // Lógica de Botones de Tamaño
            const priceElement = document.getElementById('product-price');
            const idElement = document.getElementById('product-id');
            const colorNameElement = document.getElementById('selected-color-name');
            const colorButtons = document.querySelectorAll('.color-btn');

            colorButtons.forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    colorButtons.forEach(btn => btn.classList.remove('active'));
                    this.classList.add('active');

                    priceElement.innerText = this.getAttribute('data-price');
                    idElement.value = this.getAttribute('data-id');
                    colorNameElement.innerText = this.getAttribute('data-color-name');
                });
            });

            // Lógica de Cantidad
            const plusBtn = document.getElementById('quantity-plus');
            const minusBtn = document.getElementById('quantity-minus');
            const quantityInput = document.getElementById('quantity-input');

            plusBtn.addEventListener('click', () => { quantityInput.value = parseInt(quantityInput.value) + 1; });
            minusBtn.addEventListener('click', () => {
                if (parseInt(quantityInput.value) > 1) quantityInput.value = parseInt(quantityInput.value) - 1;
            });

            // ── Carrusel infinito de sugerencias ──
            (function () {
                const track = document.getElementById('sugerencias-track');
                const btnL  = document.getElementById('arrow-left');
                const btnR  = document.getElementById('arrow-right');
                if (!track || !btnL || !btnR) return;

                const origCards = Array.from(track.querySelectorAll('.sug-card-wrap'));
                const n = origCards.length;
                if (n < 2) return;

                // Construir: [clonesIzq][originales][clonesder]
                const fragIzq = document.createDocumentFragment();
                const fragDer = document.createDocumentFragment();
                origCards.forEach(c => fragDer.appendChild(c.cloneNode(true)));
                origCards.forEach(c => fragIzq.appendChild(c.cloneNode(true)));
                track.insertBefore(fragIzq, track.firstChild);
                track.appendChild(fragDer);

                // Lazy load para todos los videos (originales + clones)
                const videoObs = new IntersectionObserver((entries) => {
                    entries.forEach(e => {
                        const v = e.target;
                        if (e.isIntersecting) { if (v.readyState === 0) v.load(); v.play().catch(() => {}); }
                        else v.pause();
                    });
                }, { rootMargin: '100px 0px', threshold: 0.1 });
                track.querySelectorAll('video').forEach(v => videoObs.observe(v));

                const gap   = 16;
                const cardW = () => origCards[0].offsetWidth + gap;
                const setW  = () => cardW() * n;

                // Posicionar en los originales (saltar los clones izquierdos)
                track.style.scrollBehavior = 'auto';
                track.scrollLeft = setW();
                requestAnimationFrame(() => { track.style.scrollBehavior = 'smooth'; });

                let busy = false;

                function reposicionar() {
                    const sl = track.scrollLeft;
                    const sw = setW();
                    // Si entró en el área de clones izquierdos → saltar al espejo en originales
                    if (sl < sw * 0.5) {
                        track.style.scrollBehavior = 'auto';
                        track.scrollLeft = sl + sw;
                        requestAnimationFrame(() => { track.style.scrollBehavior = 'smooth'; });
                    }
                    // Si entró en el área de clones derechos → saltar al espejo en originales
                    else if (sl > sw * 1.5) {
                        track.style.scrollBehavior = 'auto';
                        track.scrollLeft = sl - sw;
                        requestAnimationFrame(() => { track.style.scrollBehavior = 'smooth'; });
                    }
                    busy = false;
                }

                btnR.addEventListener('click', () => {
                    if (busy) return;
                    busy = true;
                    track.scrollBy({ left: cardW(), behavior: 'smooth' });
                    setTimeout(reposicionar, 380);
                });

                btnL.addEventListener('click', () => {
                    if (busy) return;
                    busy = true;
                    track.scrollBy({ left: -cardW(), behavior: 'smooth' });
                    setTimeout(reposicionar, 380);
                });
            })();
        });
    </script>
</body>